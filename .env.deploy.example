# Copy to .env.deploy and fill in — .env.deploy is gitignored.
# Used by `npm run deploy` (scripts/deploy.sh). See docs/DEPLOYMENT.md.

SFTP_HOST=example.com
SFTP_USER=your-sftp-user
SFTP_PORT=22
SFTP_REMOTE_PATH=/path/to/webroot

# Use one of the two:
SFTP_PRIVATE_KEY=
SFTP_PASSWORD=

# Contents of `ssh-keyscan -p $SFTP_PORT $SFTP_HOST` — optional but recommended,
# otherwise the script trusts the host key on first connect.
SFTP_KNOWN_HOSTS=

# Optional: space-separated extra glob patterns to never upload/delete.
SFTP_EXCLUDE=
